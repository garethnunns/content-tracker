{
  "name": "@garethnunns/content-tracker",
  "productName": "Content Tracker",
  "version": "1.0.0",
  "description": "Track the content in your folders on Airtable or Google Sheets",
  "type": "module",
  "main": "out/main/index.js",
  "exports": {
    ".": "./core/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "content-tracker": "cli/index.js",
    "tracker": "cli/index.js"
  },
  "files": [
    "cli",
    "core",
    "!**/*.test.js"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "electron-vite build && electron-builder",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm test && npm run build",
    "check": "npm run verify && npm run test:e2e",
    "icons": "node scripts/icons.mjs",
    "schema": "node scripts/schema.mjs",
    "readme": "node scripts/readme.mjs",
    "dist:mac": "npm install --no-save --force @ffprobe-installer/darwin-x64@5.1.0 @ffprobe-installer/darwin-arm64@5.0.1 && electron-vite build && electron-builder --mac --arm64 --x64",
    "screenshots": "electron-vite build && node scripts/screenshots.mjs",
    "prepare": "node scripts/oauth-secret.mjs"
  },
  "keywords": [
    "airtable",
    "google-sheets",
    "ffprobe",
    "media",
    "content"
  ],
  "author": "Generative Noise",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/garethnunns/content-tracker.git"
  },
  "bugs": {
    "url": "https://github.com/garethnunns/content-tracker/issues"
  },
  "homepage": "https://github.com/garethnunns/content-tracker#readme",
  "dependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@inquirer/confirm": "^6.4.0",
    "chalk": "^6.0.1",
    "commander": "^12.1.0",
    "figlet": "^1.12.0",
    "google-auth-library": "^11.3.4",
    "p-queue": "^10.0.0",
    "picomatch": "^4.0.7",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.13.0",
    "marked": "^18.1.2",
    "sharp": "^0.35.5",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue": "^3.5.44"
  }
}
